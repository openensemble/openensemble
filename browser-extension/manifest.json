{
  "manifest_version": 3,
  "name": "OpenEnsemble Bridge",
  "short_name": "OE Bridge",
  "version": "0.7.0",
  "description": "Ask, clip, compare, block ads locally, teach browser procedures, watch fields, and run confirmed tasks with scoped access.",
  "permissions": ["tabs", "storage", "scripting", "activeTab", "alarms", "sidePanel", "contextMenus", "declarativeNetRequestWithHostAccess"],
  "omnibox": { "keyword": "oe" },
  "side_panel": { "default_path": "sidepanel.html" },
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "oe_ads",
        "enabled": true,
        "path": "rules/ads.json"
      }
    ]
  },
  "icons": {
    "16": "icons/oe-bridge-16.png",
    "32": "icons/oe-bridge-32.png",
    "48": "icons/oe-bridge-48.png",
    "128": "icons/oe-bridge-128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content-adblock.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content-banner.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content-observe.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content-field-picker.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "OpenEnsemble Bridge",
    "default_icon": {
      "16": "icons/oe-bridge-16.png",
      "32": "icons/oe-bridge-32.png",
      "48": "icons/oe-bridge-48.png",
      "128": "icons/oe-bridge-128.png"
    }
  }
}
